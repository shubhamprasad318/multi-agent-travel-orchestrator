# Copy to .env and fill in. Only GOOGLE_API_KEY is required.

# --- Gemini (free key: https://aistudio.google.com/apikey) ---
GOOGLE_API_KEY=
# gemini-2.5-* is closed to new projects; 3.x models are on the free tier.
# GEMINI_MODEL=gemini-3.8-flash
# Used when the main model is overloaded or out of quota (empty = no fallback)
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Live Google Search grounding with citations (auto-disables if unavailable)
# ENABLE_GROUNDING=true

# --- Optional persistence (defaults to in-memory) ---
# MONGODB_URI=mongodb://localhost:27017
# DATABASE_NAME=travel_orchestrator

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=5
MAX_CONCURRENT_PLANS=2

# --- Optional: Google sign-in (accounts, trip sync, sharing with friends) ---
# OAuth *web* client id from https://console.cloud.google.com/apis/credentials
# (the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID must be the same value).
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Long random string that signs session tokens: python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_SECRET=

# --- Optional: real flight fares (free) ---
# Travelpayouts token (Aviasales Data API): cached fares other travellers found recently.
# TRAVELPAYOUTS_TOKEN=
# TRAVELPAYOUTS_MARKER=
