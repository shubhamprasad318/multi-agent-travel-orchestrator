# URL of the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Google sign-in. The OAuth web client id (same as the backend's GOOGLE_CLIENT_ID).
# If unset, the app asks the backend for it; sign-in is hidden when the backend has none.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
